# Carpeta de salida de compilación (PDFs, auxiliares)
build/

# Archivos auxiliares de LaTeX
*.aux      # Referencias internas, índices
*.log      # Registro de compilación
*.toc      # Tabla de contenidos
*.out      # Archivos de salida auxiliares
*.lof      # Lista de figuras
*.lot      # Lista de tablas

# Archivos de bibliografía
*.bbl      # Bibliografía generada por Biber/BibTeX
*.blg      # Log de bibliografía

# Archivos de latexmk
*.fls
*.fdb_latexmk
*.run.xml

# Archivos de sincronización PDF <-> TEX
*.synctex.gz

# Archivos temporales del sistema
.DS_Store  # MacOS
Thumbs.db  # Windows

# Otros archivos que pueden generarse automáticamente
*.nav      # Beamer navigation
*.snm      # Beamer
*.vrb      # Beamer verbatim
*.toc      # Tabla de contenido (ya mencionado)
